# Base de données locale (SQLite, créée automatiquement)
DATABASE_URL="file:./dev.db"

# Clé API Claude pour le tuteur IA, les histoires et la correction des textes.
# À créer sur https://console.anthropic.com (Settings > API keys).
# Sans clé, l'appli fonctionne quand même : révisions, répétition, alphabet, tableau de bord.
ANTHROPIC_API_KEY=""

# Modèle utilisé (facultatif)
ANTHROPIC_MODEL="claude-sonnet-5-5"
