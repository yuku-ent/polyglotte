# Base PostgreSQL. Le plus simple : Vercel > ton projet > Storage > Neon (gratuit),
# qui crée ces deux variables automatiquement. Copie-les ici pour travailler en local.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# IA (tuteur, histoires, correction de l'écrit) : UNE des deux clés suffit.
# Gratuit : clé Gemini sur https://aistudio.google.com (Get API key). Aucune carte bancaire.
GEMINI_API_KEY=""
# Modèle Gemini (facultatif) : copie le nom exact depuis AI Studio si celui-ci ne marche pas.
GEMINI_MODEL="gemini-flash-latest"

# Payant : clé Claude sur https://console.anthropic.com. Utilisée en priorité si elle est remplie.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Mot de passe pour protéger l'appli en ligne (fortement conseillé sur Vercel).
# Le navigateur le demande une fois ; n'importe quel nom d'utilisateur convient.
APP_PASSWORD=""
