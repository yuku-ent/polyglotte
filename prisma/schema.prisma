// Schéma de données de Polyglotte.
// Après une modification : npm run db:push

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL : Neon (via Vercel > Storage), Supabase ou un Postgres local.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Un seul profil local pour l'instant (appli personnelle).
model Profile {
  id            String   @id
  name          String?
  currentLang   String   @default("en") // en | es | ar
  dailyGoal     Int      @default(50) // objectif d'XP par jour
  xp            Int      @default(0)
  streak        Int      @default(0)
  bestStreak    Int      @default(0)
  lastActiveDay String? // "YYYY-MM-DD"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  languages     LanguageProgress[]
  cards         Card[]
  days          ActivityDay[]
  journal       JournalEntry[]
  stories       Story[]
  conversations Conversation[]
}

/// Niveau et variante choisis pour chaque langue.
model LanguageProgress {
  id        String  @id @default(cuid())
  profileId String
  lang      String
  level     String  @default("A1") // A1 | A2 | B1 | B2 | C1
  variety   String // ex. "us", "es", "msa", "darija"
  deckSeeded Boolean @default(false)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, lang])
}

/// Carte de vocabulaire, planifiée par l'algorithme de répétition espacée (SM-2).
model Card {
  id          String   @id @default(cuid())
  profileId   String
  lang        String
  term        String
  translation String
  translit    String?
  example     String?
  source      String   @default("deck") // deck | story | custom | conversation
  ease        Float    @default(2.5)
  interval    Int      @default(0) // en jours
  reps        Int      @default(0)
  lapses      Int      @default(0)
  dueAt       DateTime @default(now())
  createdAt   DateTime @default(now())

  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviews ReviewLog[]

  @@unique([profileId, lang, term])
  @@index([profileId, lang, dueAt])
}

model ReviewLog {
  id         String   @id @default(cuid())
  cardId     String
  grade      Int // 0 à revoir, 1 difficile, 2 bien, 3 facile
  wasNew     Boolean  @default(false)
  reviewedAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([reviewedAt])
}

/// Une ligne par jour d'activité : sert à la série (streak), aux missions et à l'historique.
model ActivityDay {
  id         String @id @default(cuid())
  profileId  String
  day        String // "YYYY-MM-DD"
  xp         Int    @default(0)
  reviews    Int    @default(0)
  stories    Int    @default(0)
  speakTurns Int    @default(0)
  shadowing  Int    @default(0)
  writings   Int    @default(0)
  alphabet   Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, day])
}

model JournalEntry {
  id        String   @id @default(cuid())
  profileId String
  lang      String
  prompt    String?
  text      String
  corrected String
  natural   String
  score     Int
  feedback  String // JSON : erreurs, points forts, conseil
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, lang, createdAt])
}

model Story {
  id        String   @id @default(cuid())
  profileId String
  lang      String
  level     String
  topic     String
  title     String
  content   String // JSON : phrases, vocabulaire, questions
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, lang, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  profileId String
  lang      String
  scenario  String
  createdAt DateTime @default(now())

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "tutor"
  content        String
  translation    String?
  translit       String?
  correction     String? // JSON
  suggestions    String? // JSON
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
